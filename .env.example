APP_ENV=development
API_PORT=8080
WORKER_METRICS_PORT=9091
DATABASE_URL=postgres://sales:sales@postgres:5432/sales_event?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=sales.exchange
SALES_CREATED_QUEUE=sales.created.queue
SALE_COMPLETED_QUEUE=sale.completed.queue
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

RETENTION_ENABLED=true
RETENTION_INTERVAL=24h
RETENTION_PUBLISHED_OUTBOX_MAX_AGE=720h
RETENTION_SENT_EMAIL_MAX_AGE=2160h
